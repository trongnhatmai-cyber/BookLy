@model BookLy_Project.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Tổng quan thư viện";
    var maxCount = Model.DailyBorrowStats.Any() ? Model.DailyBorrowStats.Max(x => x.BookCount) : 0;
    var currentWeek = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    .admin-dashboard { width: 100%; max-width: 1440px; margin: 0 auto; }
    .weekly-chart { min-height: 250px; display: flex; align-items: end; gap: clamp(12px, 3vw, 34px); padding: 24px 12px 0; }
    .weekly-column { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: end; height: 190px; gap: 9px; }
    .weekly-value { min-height: 18px; color: #64748b; font-size: 12px; font-weight: 600; }
    .weekly-bar-area { width: min(100%, 56px); height: 140px; display: flex; align-items: end; }
    .weekly-bar { width: 100%; min-height: 0; border-radius: 7px 7px 0 0; background: linear-gradient(180deg,#60a5fa 0%,#1672df 100%); transition: height .25s ease; }
    .weekly-day { color: #64748b; font-size: 12px; font-weight: 600; }
    @@media(max-width: 640px) {
        .weekly-chart { gap: 8px; padding-inline: 0; }
        .weekly-column { height: 170px; }
        .weekly-bar-area { height: 115px; width: min(100%, 38px); }
    }
</style>

<div class="admin-dashboard space-y-6">
    <header class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Tổng quan thư viện</h1>
            <p class="mt-1 text-sm text-slate-500">Theo dõi nhanh hoạt động của BOOKLY.</p>
        </div>
        <span class="text-sm text-slate-500">Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
    </header>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Tổng số sách</p>
            <p class="mt-2 text-3xl font-bold text-slate-900">@Model.TotalBooks</p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Đang được mượn</p>
            <p class="mt-2 text-3xl font-bold text-slate-900">@Model.BorrowedBooks</p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Người dùng</p>
            <p class="mt-2 text-3xl font-bold text-slate-900">@Model.TotalUsers</p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Phiếu quá hạn</p>
            <p class="mt-2 text-3xl font-bold text-slate-900">@Model.ExpiredRequests</p>
        </article>
    </section>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 border-b border-slate-100 p-5 sm:p-6 md:flex-row md:items-center md:justify-between">
            <div>
                <h2 class="text-lg font-bold text-slate-900">Lượt mượn sách</h2>
                <p class="mt-1 text-sm text-slate-500">Số cuốn sách được mượn theo từng ngày trong tuần</p>
            </div>
            <form asp-controller="Admin" asp-action="Index" method="get" class="flex flex-wrap items-end gap-2">
                <div>
                    <label for="weekOf" class="mb-1 block text-xs font-semibold text-slate-600">Chọn một ngày trong tuần</label>
                    <input id="weekOf" name="weekOf" type="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
                </div>
                <button type="submit" class="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Áp dụng</button>
                <a asp-controller="Admin" asp-action="Index" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Tuần này</a>
            </form>
        </div>

        <div class="p-5 sm:p-6">
            <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm font-semibold text-slate-800">
                    @Model.WeekStart.ToString("dd/MM/yyyy") – @Model.WeekStart.AddDays(6).ToString("dd/MM/yyyy")
                </p>
                <p class="text-sm text-slate-500">Tổng <strong class="text-slate-900">@Model.TotalBorrowedInWeek</strong> cuốn sách</p>
            </div>

            <div class="weekly-chart" role="img" aria-label="Biểu đồ số sách mượn theo từng ngày trong tuần">
                @foreach (var item in Model.DailyBorrowStats)
                {
                    var barHeight = maxCount == 0 ? 0 : Math.Max(5, (int)Math.Round((double)item.BookCount / maxCount * 100));
                    <div class="weekly-column" title="@item.Date.ToString("dd/MM/yyyy"): @item.BookCount cuốn">
                        <span class="weekly-value">@item.BookCount</span>
                        <div class="weekly-bar-area">
                            <div class="weekly-bar" style="height: @barHeight%;"></div>
                        </div>
                        <span class="weekly-day">@item.DayLabel</span>
                    </div>
                }
            </div>

            @if (Model.TotalBorrowedInWeek == 0)
            {
                <p class="mt-4 rounded-xl bg-slate-50 px-4 py-3 text-center text-sm text-slate-500">
                    Chưa có lượt mượn sách trong tuần này.
                </p>
            }
        </div>
        <p class="border-t border-slate-100 px-5 py-3 text-xs leading-5 text-slate-500 sm:px-6">
            Ghi chú: biểu đồ cộng số lượng sách trong chi tiết phiếu mượn theo ngày tạo phiếu (RequestedAt), không đếm số phiếu.
        </p>
    </section>
</div>
