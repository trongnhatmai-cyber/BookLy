
@model IEnumerable<BookLy_Project.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="min-h-screen bg-slate-50 p-6 md:p-8">
    <div class="mx-auto max-w-7xl">

        @if (TempData["Success"] != null)
        {
            <div class="mb-4 rounded-xl bg-green-50 px-4 py-3 text-sm text-green-700">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div>
        }

        <!-- Tiêu đề -->
        <div class="flex items-center justify-between">
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-slate-800">
                    Quản lý người dùng
                </h1>
                <p class="mt-2 text-sm text-slate-500">
                    Quản lý tài khoản học sinh và quản trị viên trong BookLy.
                </p>
            </div>
            <a asp-controller="Admin"
                   asp-action="CreateUser"
                   class="rounded-xl bg-blue-600 px-5 py-3
                text-sm font-semibold text-white hover:bg-blue-700">
                + Tạo người dùng
            </a>
        </div>

        <!-- Thống kê -->
        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm text-slate-500">Tổng tài khoản</p>
                <p class="mt-2 text-3xl font-bold text-slate-800">
                    @Model.Count()
                </p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm text-slate-500">Học sinh</p>
                <p class="mt-2 text-3xl font-bold text-blue-600">
                    @Model.Count(u => u.Role == "Student")
                </p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm text-slate-500">Quản trị viên</p>
                <p class="mt-2 text-3xl font-bold text-indigo-600">
                    @Model.Count(u => u.Role == "Admin")
                </p>
            </div>

        </div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

            <!-- Header -->
            <div class="border-b border-slate-100 p-5">

                <div class="mb-5">
                    <h2 class="text-lg font-bold text-slate-800">
                        Danh sách tài khoản
                    </h2>
                    <p class="mt-1 text-sm text-slate-500">
                        Xem thông tin và quản lý trạng thái tài khoản.
                    </p>
                </div>

                <!-- Bulk action -->
                <form id="bulkUserForm" asp-action="BulkUserAction" method="post"
                      class="mb-4 flex flex-wrap items-center gap-2">

                    @Html.AntiForgeryToken()

                    <select name="action"
                            class="min-w-[180px] rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:border-blue-500"
                            required>
                        <option value="">Thao tác hàng loạt</option>
                        <option value="Lock">Khóa tài khoản</option>
                        <option value="Unlock">Mở khóa tài khoản</option>
                        <option value="Delete">Xóa tài khoản</option>
                    </select>

                    <button type="submit" id="bulkUserSubmit"
                            class="rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">
                        Thực hiện
                    </button>
                </form>

                <!-- Search and filters -->
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

                    <input id="searchUser" type="search"
                           placeholder="Tìm tên, username, mã sinh viên, email..."
                           class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white lg:col-span-2" />

                    <select id="userRoleFilter"
                            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:border-blue-500">
                        <option value="">Tất cả vai trò</option>
                        <option value="Student">Học sinh</option>
                        <option value="Admin">Admin</option>
                    </select>

                    <select id="userStatusFilter"
                            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:border-blue-500">
                        <option value="">Mọi trạng thái</option>
                        <option value="Active">Hoạt động</option>
                        <option value="Locked">Đã khóa</option>
                    </select>

                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="table-bordered w-full text-center text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-3 py-4">
                            <input type="checkbox" id="selectAllUsers" class="h-4 w-4 rounded border-slate-300" title="Chọn tất cả học sinh đang hiển thị" />
                        </th>
                        <th class="whitespace-nowrap px-5 py-4 font-semibold">
                            Người dùng
                        </th>
                        <th class="px-5 py-4 font-semibold">Mã sinh viên</th>
                        <th class="px-5 py-4 font-semibold">Email</th>
                        <th class="px-5 py-4 font-semibold">Vai trò</th>
                        <th class="px-5 py-4 font-semibold">Trạng thái</th>
                        <th class="px-5 py-4 font-semibold">
                            Thao tác
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100" id="userTable">

                    @foreach (var user in Model)
                    {
                        <tr class="user-row transition hover:bg-slate-50" data-role="@(user.Role ?? "")" data-status="@(user.Status ?? "")">
                            <td class="px-3 py-5">
                                @if (user.Role == "Student")
                                {
                                    <input type="checkbox" name="selectedIds" value="@user.UserId" form="bulkUserForm" class="user-checkbox h-4 w-4 rounded border-slate-300" aria-label="Chọn @user.FullName" />
                                }
                            </td>

                            <td class="px-5 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-10 w-10 shrink-0
                                        items-center justify-center
                                        rounded-full bg-blue-50
                                        font-bold text-blue-600">
                                        @(string.IsNullOrEmpty(user.FullName)
                                            ? "?"
                                            : user.FullName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <p class="user-name font-semibold text-slate-800">
                                            @user.FullName
                                        </p>
                                        <p class="user-username mt-1 text-xs text-slate-400">
                                            @user.Username
                                        </p>
                                    </div>
                                </div>
                            </td>

                            <td class="user-code px-5 py-5 text-slate-600">
                                @(string.IsNullOrEmpty(user.StudentCode)
                                    ? "—"
                                    : user.StudentCode)
                            </td>

                            <td class="user-email px-5 py-5 text-slate-600">
                                @user.Email
                            </td>

                            <td class="px-5 py-5">
                                @if (user.Role == "Admin")
                                {
                                    <span class="rounded-full bg-indigo-50 px-3 py-1.5
                                        text-xs font-semibold text-indigo-700">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-blue-50 px-3 py-1.5
                                        text-xs font-semibold text-blue-700">
                                        Học sinh
                                    </span>
                                }
                            </td>

                            <td class="px-5 py-5">
                                @if (user.Status == "Active")
                                {
                                    <span class="rounded-full bg-green-50 px-3 py-1.5
                                        text-xs font-semibold text-green-700">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-red-50 px-3 py-1.5
                                        text-xs font-semibold text-red-600">
                                        Đã khóa
                                    </span>
                                }
                            </td>

                            <td class="px-5 py-5">
                                <div class="flex justify-between ">
                                    <form asp-action="ToggleUserStatus"
                                            method="post"
                                            onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản này không?');">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id"
                                                value="@user.UserId" />

                                        @if (user.Status == "Active")
                                        {
                                            <button type="submit"
                                                    class="rounded-lg bg-red-50 px-3 py-2
                                                text-xs font-semibold text-red-600
                                                hover:bg-red-100">
                                                Khóa
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="rounded-lg bg-green-50 px-3 py-2
                                                text-xs font-semibold text-green-700
                                                hover:bg-green-100">
                                                Mở khóa
                                            </button>
                                        }
                                    </form>
                                    @if (user.Role != "Admin")
                                    {
                                        <a asp-controller="Admin"
                                                asp-action="ChangePassword"
                                                asp-route-userId="@user.UserId" class="rounded-lg bg-blue-600 text-xs font-semibold text-white px-3 py-2">
                                            Đổi mật khẩu
                                        </a>
                                    }
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>

            <div id="noUsers"
                    class="hidden px-6 py-12 text-center text-slate-400">
                Không tìm thấy người dùng phù hợp.
            </div>

            @if (!Model.Any())
            {
                <div class="px-6 py-12 text-center text-slate-400">
                    Chưa có tài khoản nào.
                </div>
            }
        </div>

        <div class="border-t border-slate-100 bg-slate-50 px-6 py-4 text-sm text-slate-500">
            Tổng cộng @Model.Count() tài khoản
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput=document.getElementById('searchUser');
            const roleFilter=document.getElementById('userRoleFilter');
            const statusFilter=document.getElementById('userStatusFilter');
            const rows=[...document.querySelectorAll('.user-row')];
            const noUsers=document.getElementById('noUsers');
            const normalize=value=>(value||'').toLocaleLowerCase('vi').trim();
            function filterUsers(){
                const keyword=normalize(searchInput.value); let count=0;
                rows.forEach(row=>{
                    const textMatch=normalize(row.textContent).includes(keyword);
                    const roleMatch=!roleFilter.value||row.dataset.role===roleFilter.value;
                    const statusMatch=!statusFilter.value||row.dataset.status===statusFilter.value;
                    const show=textMatch&&roleMatch&&statusMatch;
                    row.classList.toggle('hidden',!show); if(show)count++;
                });
                noUsers.classList.toggle('hidden',count>0);
                noUsers.textContent=count===0?'Không tìm thấy người dùng phù hợp.': '';
            }
            searchInput.addEventListener('input',filterUsers);
            roleFilter.addEventListener('change',filterUsers);
            statusFilter.addEventListener('change',filterUsers);

            const selectAll = document.getElementById('selectAllUsers');
            const userCheckboxes = [...document.querySelectorAll('.user-checkbox')];
            const bulkForm = document.getElementById('bulkUserForm');

            selectAll.addEventListener('change', function () {
                userCheckboxes.forEach(box => {
                    if (!box.closest('tr').classList.contains('hidden')) box.checked = selectAll.checked;
                });
            });

            userCheckboxes.forEach(box => box.addEventListener('change', function () {
                const visible = userCheckboxes.filter(item => !item.closest('tr').classList.contains('hidden'));
                selectAll.checked = visible.length > 0 && visible.every(item => item.checked);
            }));

            bulkForm.addEventListener('submit', function (event) {
                const selected = userCheckboxes.filter(box => box.checked).length;
                const action = bulkForm.querySelector('[name="action"]').value;
                if (selected === 0 || !action) {
                    event.preventDefault();
                    alert('Vui lòng chọn học sinh và thao tác cần thực hiện.');
                    return;
                }
                const actionText = action === 'Delete' ? 'xóa' : (action === 'Lock' ? 'khóa' : 'mở khóa');
                if (!confirm(`Bạn có chắc muốn ${actionText} ${selected} tài khoản đã chọn không?`)) event.preventDefault();
            });

            filterUsers();
        });
    </script>
}