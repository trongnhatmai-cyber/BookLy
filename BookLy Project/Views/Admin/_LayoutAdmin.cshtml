<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function () {
            const savedTheme = localStorage.getItem("bookly-theme");
            if (savedTheme === "dark") document.documentElement.classList.add("dark");
        })();
    </script>
    <title>@ViewData["Title"] - BOOKLY</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var adminLinkBase = "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors";
        var adminLinkActive = "bg-blue-50 text-blue-700";
        var adminLinkIdle = "text-slate-600 hover:bg-slate-50 hover:text-slate-900";
    }

    <div class="flex min-h-screen flex-col lg:flex-row">
        <!-- Sidebar -->
        <aside class="w-full border-b border-slate-200 bg-white p-4 sm:p-5 lg:sticky lg:top-0 lg:h-screen lg:w-64 lg:shrink-0 lg:overflow-y-auto lg:border-b-0 lg:border-r">
            <div>
                <!-- Logo & Brand -->
                <div class="mb-8">
                    <h1 class="text-2xl font-bold text-blue-600 tracking-tight">BOOKLY.</h1>
                    <p class="text-xs text-gray-400 mt-0.5">Thư viện của bạn</p>
                    <button type="button" id="themeToggle" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
                        <span id="themeIcon">🌙</span>
                        <span id="themeText">Chế độ tối</span>
                    </button>
                </div>

                <!-- Navigation Menu -->
                <div class="space-y-4">
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Khám phá</p>
                        <nav class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-1">
                            <a asp-controller="Admin" asp-action="Index" class="@adminLinkBase @(currentController == "Admin" && currentAction == "Index" ? adminLinkActive : adminLinkIdle)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                                <span>Tổng quan</span>
                            </a>
                            <a asp-action="BookManager" class="@adminLinkBase @(currentAction == "BookManager" || currentAction == "CreateBook" || currentAction == "EditBook" ? adminLinkActive : adminLinkIdle)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                                <span>Quản lý sách</span>
                            </a>
                            <a asp-action="CategoryManager" class="@adminLinkBase @(currentAction?.Contains("Category") == true ? adminLinkActive : adminLinkIdle)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                <span>Thể loại</span>
                            </a>
                            <a asp-action="BorrowManager" class="@adminLinkBase @(currentAction?.Contains("Borrow") == true ? adminLinkActive : adminLinkIdle)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                                <span>Mượn & Trả</span>
                            </a>
                            <a asp-action="UserManager" class="@adminLinkBase @(currentAction?.Contains("User") == true ? adminLinkActive : adminLinkIdle)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                                <span>Người dùng</span>
                            </a>
                            <a asp-controller="Admin"
                                   asp-action="Profile"
                                   class="flex items-center gap-3 rounded-xl px-4 py-3
                                text-slate-600 transition hover:bg-blue-50 hover:text-blue-600">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg>
                                <span>Hồ sơ người dùng</span>
                            </a>
                            <a asp-controller="Home"
                                   asp-action="Logout"
                                   class="flex items-center gap-3 rounded-xl px-4 py-3
                                text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M10 17l5-5-5-5M15 12H3"/><path d="M13 3h5a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3h-5"/></svg>
                                <span>Đăng xuất</span>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="min-w-0 flex-1 bg-slate-50 p-4 sm:p-6 xl:p-8">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)

    <script>
        (function () {
            const button = document.getElementById("themeToggle");
            const icon = document.getElementById("themeIcon");
            const label = document.getElementById("themeText");

            function updateThemeButton() {
                const isDark = document.documentElement.classList.contains("dark");
                if (icon) icon.textContent = isDark ? "☀️" : "🌙";
                if (label) label.textContent = isDark ? "Chế độ sáng" : "Chế độ tối";
                document.documentElement.style.colorScheme = isDark ? "dark" : "light";
            }

            updateThemeButton();
            if (button) {
                button.addEventListener("click", function () {
                    const isDark = document.documentElement.classList.toggle("dark");
                    localStorage.setItem("bookly-theme", isDark ? "dark" : "light");
                    updateThemeButton();
                });
            }
        })();
    </script>
</body>
</html>
