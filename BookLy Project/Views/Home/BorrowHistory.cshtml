@model IEnumerable<BookLy_Project.Models.BorrowRequest>

@{
    ViewData["Title"] = "Lịch sử mượn sách";
}

<div class="min-h-screen bg-slate-50 px-3 py-5 sm:px-6 sm:py-8">
    <div class="mx-auto max-w-6xl">

        <h1 class="mb-2 text-3xl font-bold text-slate-800">
            Lịch sử mượn sách
        </h1>

        <p class="mb-8 text-slate-500">
            Theo dõi các phiếu mượn và tình trạng trả sách của bạn.
        </p>

        @if (Model.Any())
        {
            <div class="mb-6 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:flex-row">
                <input id="historySearch" type="search" placeholder="Tìm theo tên sách hoặc mã phiếu..." class="w-full flex-1 rounded-xl border border-slate-200 px-4 py-3 text-sm" />
                <select id="historyStatus" class="rounded-xl border border-slate-200 px-4 py-3 text-sm">
                    <option value="">Tất cả trạng thái</option><option value="Pending">Chờ duyệt</option><option value="Approved">Đang mượn</option><option value="Overdue">Quá hạn</option><option value="Returned">Đã trả</option><option value="Cancelled">Đã hủy</option>
                </select>
            </div>
            <p id="historyCount" class="mb-4 text-sm text-slate-500"></p>
        }

        @if (!Model.Any())
        {
            <div class="rounded-2xl bg-white p-10 text-center shadow-sm">
                <div class="mb-4 flex justify-center"><svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22z"/><path d="M4 4.5V22M8 6h8M8 10h8"/></svg></div>

                <h2 class="mb-3 text-xl font-semibold text-slate-700">
                    Bạn chưa có lịch sử mượn sách
                </h2>

                <p class="mb-6 text-slate-500">
                    Hãy khám phá thư viện và chọn cuốn sách bạn muốn đọc.
                </p>

                <a asp-controller="Book"
                   asp-action="Index"
                   class="rounded-lg bg-blue-600 px-5 py-3 text-white hover:bg-blue-700">
                    Khám phá sách
                </a>
            </div>
        }
        else
        {
            <div class="space-y-5">

                @foreach (var request in Model)
                {
                    var detail = request.BorrowDetails.FirstOrDefault();
                    var book = detail?.Book;

                    <div class="borrow-history-card rounded-2xl bg-white p-5 shadow-sm"
                         data-status="@(request.Status ?? "")" data-book="@(book?.Title ?? "")" data-borrow-id="@request.BorrowId">

                        <div class="flex flex-col gap-5 sm:flex-row">

                            @if (book != null)
                            {
                                <img src="@book.ImageUrl"
                                     alt="@book.Title"
                                     class="h-40 w-28 rounded-lg object-cover"
                                     onerror="this.style.display='none'" />

                                <div class="flex-1">

                                    <h2 class="mb-2 text-xl font-bold text-slate-800">
                                        @(book.Title ?? "Không có tên sách")
                                    </h2>

                                    <p class="mb-1 text-slate-500">
                                        Tác giả: @(book.Author ?? "Chưa cập nhật")
                                    </p>

                                    <p class="mb-1 text-slate-500">
                                        Ngày yêu cầu: @request.RequestedAt
                                    </p>

                                    <p class="mb-3 text-slate-500">
                                        Hạn trả:
                                        @(request.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa có")
                                    </p>

                                    @if (request.Status == "Pending")
                                    {
                                        <span class="rounded-full bg-yellow-100 px-3 py-1 text-sm text-yellow-700">
                                            Chờ duyệt
                                        </span>
                                    }
                                    else if (request.Status == "Approved")
                                    {
                                        <span class="rounded-full bg-blue-100 px-3 py-1 text-sm text-blue-700">
                                            Đang mượn
                                        </span>
                                    }
                                    else if (request.Status == "Overdue")
                                    {
                                        <span class="rounded-full bg-red-100 px-3 py-1 text-sm text-red-700">
                                            Quá hạn
                                        </span>
                                    }
                                    else if (request.Status == "Returned")
                                    {
                                        <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-700">
                                            Đã trả
                                        </span>
                                    }
                                    else if (request.Status == "Cancelled")
                                    {
                                        <span class="rounded-full bg-slate-200 px-3 py-1 text-sm text-slate-600">
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-600">
                                            @request.Status
                                        </span>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="flex-1">
                                    <p class="font-semibold text-slate-700">
                                        Phiếu mượn #@request.BorrowId
                                    </p>

                                    <p class="mt-2 text-slate-500">
                                        Không tìm thấy thông tin sách của phiếu này.
                                    </p>
                                </div>
                            }

                            <div class="flex flex-col gap-2">
                                <div class=" text-sm text-slate-400">
                                Mã phiếu: #@request.BorrowId
                                </div>

                                @if (request.Status == "Pending")
                                {
                                    <form asp-controller="Home"
                                          asp-action="CancelBorrow"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn thu hồi đơn mượn này không?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.BorrowId" />

                                        <button type="submit"
                                                class="rounded-lg bg-red-50 px-4 py-2
                                            text-sm font-semibold text-red-600
                                            hover:bg-red-100">
                                            Thu hồi đơn
                                        </button>
                                    </form>
                                }
                            </div>

                        </div>
                    </div>
                }

            </div>
            <div id="historyNoResults" class="hidden rounded-xl bg-white p-8 text-center text-slate-500">Không tìm thấy phiếu mượn phù hợp.</div>
        }

    </div>
</div>

@section Scripts {
<script>
 document.addEventListener('DOMContentLoaded',function(){
  const search=document.getElementById('historySearch'),status=document.getElementById('historyStatus'); if(!search||!status)return;
  const cards=[...document.querySelectorAll('.borrow-history-card')], empty=document.getElementById('historyNoResults'), count=document.getElementById('historyCount');
  const norm=v=>(v||'').toLocaleLowerCase('vi').trim();
  function filter(){let n=0;cards.forEach(c=>{const text=norm(c.dataset.book+' '+c.dataset.borrowId).includes(norm(search.value));const st=!status.value||c.dataset.status===status.value;const show=text&&st;c.classList.toggle('hidden',!show);if(show)n++;});empty.classList.toggle('hidden',n>0);count.textContent=`Hiển thị ${n}/${cards.length} phiếu mượn`;}
  search.addEventListener('input',filter);status.addEventListener('change',filter);filter();
 });
</script>
}