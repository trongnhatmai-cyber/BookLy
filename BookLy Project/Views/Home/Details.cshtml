@model BookLy_Project.Models.Book

@{
    ViewData["Title"] = "Chi tiết sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-slate-50 px-6 py-10">
    <div class="flex flex-col mx-auto max-w-5xl gap-4">

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">

            <div class="grid grid-cols-1 gap-8 md:grid-cols-3">

                <!-- Ảnh sách -->
                <div>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Title"
                             class="w-full rounded-xl object-cover shadow-sm" />
                    }
                    else
                    {
                        <div class="flex h-80 items-center justify-center rounded-xl bg-slate-100 text-slate-400">
                            Chưa có ảnh sách
                        </div>
                    }
                </div>

                <!-- Thông tin sách -->
                <div class="md:col-span-2">

                    @if (Model.AvailableQuantity > 0)
                    {
                        <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-700">
                            Còn sách
                        </span>
                    }
                    else
                    {
                        <span class="rounded-full bg-red-100 px-3 py-1 text-sm text-red-700">
                            Hết sách
                        </span>
                    }

                    <h1 class="mt-4 text-3xl font-bold text-slate-800">
                        @Model.Title
                    </h1>

                    <div class="mt-6 space-y-4 text-slate-600">
                        <p>
                            <strong class="text-slate-800">Tác giả:</strong>
                            @(Model.Author ?? "Chưa cập nhật")
                        </p>

                        <p>
                            <strong class="text-slate-800">Thể loại:</strong>
                            @(Model.Category?.CategoryName ?? "Chưa phân loại")
                        </p>

                        <p>
                            <strong class="text-slate-800">Số lượng còn:</strong>
                            @(Model.AvailableQuantity ?? 0) /
                            @(Model.TotalQuantity ?? 0)
                        </p>
                    </div>

                    <div class="flex mt-8 gap-2">
                        @if (Model.AvailableQuantity > 0)
                        {
                            
                            <form asp-controller="Home" asp-action="Borrow" method="post" asp-route-id="@Model.BookId">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="rounded-lg bg-blue-600 px-5 py-2 text-white hover:bg-blue-700">
                                    Mượn sách
                                </button>
                            </form>

                        }
                        else
                        {
                            <button disabled
                                    class="cursor-not-allowed rounded-xl bg-slate-200 px-6 py-3 font-semibold text-slate-500">
                                Sách hiện đã hết
                            </button>
                        }
                        @if (Context.Session.GetString("UserId") != null)
                        {
                            <form asp-controller="Home"
                                  asp-action="ToggleFavorite"
                                  asp-route-id="@Model.BookId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                @if (ViewBag.Favorite == true)
                                {
                                    <button type="submit"
                                            class="rounded-lg bg-pink-100 px-5 py-2 text-pink-600 hover:bg-pink-200">
                                        💔 Bỏ yêu thích
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="rounded-lg bg-pink-100 px-5 py-2 text-pink-600 hover:bg-pink-200">
                                        ❤️ Yêu thích
                                    </button>
                                }
                            </form>
                        }
                    </div>
                </div>
            </div>

            <!-- Mô tả -->
            <div class="mt-10 border-t border-slate-100 pt-8">
                <h2 class="text-xl font-bold text-slate-800">
                    Giới thiệu sách
                </h2>

                <p class="mt-4 whitespace-pre-line leading-7 text-slate-600">
                    @(Model.Description ?? "Chưa có mô tả cho cuốn sách này.")
                </p>
            </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">
            <!-- SECTION: SÁCH NỔI BẬT -->
            <div class="mb-10">

                <div class="mb-5 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-900">
                        Sách nổi bật
                    </h2>

                    <div class="flex gap-2">
                        <button type="button"
                                onclick="document.getElementById('bookSlider').scrollBy({left: -400, behavior: 'smooth'})"
                                class="rounded-full border border-slate-200 bg-white p-2
                            text-slate-600 shadow-sm hover:bg-slate-100">
                            &#8592;
                        </button>

                        <button type="button"
                                onclick="document.getElementById('bookSlider').scrollBy({left: 400, behavior: 'smooth'})"
                                class="rounded-full border border-slate-200 bg-white p-2
                            text-slate-600 shadow-sm hover:bg-slate-100">
                            &#8594;
                        </button>
                    </div>
                </div>

                <!-- HÀNG SÁCH TRƯỢT NGANG -->
                <div id="bookSlider"
                     class="flex gap-4 overflow-x-auto scroll-smooth pb-4"
                     style="scrollbar-width: none;">

                    @foreach (var book in ViewBag.list)
                    {
                        <div class="flex w-80 shrink-0 flex-col rounded-2xl
                            border border-slate-100 bg-white p-4
                            shadow-sm transition hover:-translate-y-1 hover:shadow-md">

                            <!-- ẢNH SÁCH -->
                            <a asp-controller="Home"
                                   asp-action="Details"
                                   asp-route-id="@book.BookId">
                                @if (book.ImageUrl is null)
                                {
                                    <div class="flex h-60 items-center justify-center
                                        rounded-xl bg-gradient-to-br from-blue-400 to-blue-800
                                        p-2 text-center text-xl font-semibold text-white">
                                        @book.Title
                                    </div>
                                }
                                else
                                {
                                    <img src="@book.ImageUrl"
                                         alt="@book.Title"
                                         class="h-60 w-full rounded-xl object-cover" />
                                }


                                <h3 class="mt-3 truncate text-lg font-bold text-slate-900">
                                    @book.Title
                                </h3>

                            </a>

                            <!-- TÁC GIẢ -->
                            <p class="mt-1 truncate text-xs text-slate-400">
                                @(book.Author ?? "Chưa cập nhật")
                            </p>

                            <!-- THỂ LOẠI -->
                            <div class="mt-2">
                                <span class="inline-block max-w-full truncate rounded-lg
                                    bg-blue-50 px-2 py-1 text-xs text-blue-600">
                                    @(book.Category?.CategoryName ?? "Chưa phân loại")
                                </span>
                            </div>

                            <!-- TÌNH TRẠNG -->
                            <div class="mt-2">
                                @if (book.AvailableQuantity > 0)
                                {
                                    <span class="text-xs font-medium text-green-600">
                                        Còn sách
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs font-medium text-red-500">
                                        Hết sách
                                    </span>
                                }
                            </div>

                            <!-- NÚT -->
                            <div class="mt-3 flex gap-1.5">

                                @if (book.AvailableQuantity > 0)
                                {
                                    <a asp-controller="Book"
                                           asp-action="Details"
                                           asp-route-id="@book.BookId"
                                           class="flex-1 rounded-lg bg-blue-50 px-1 py-2
                                        text-center text-xs font-semibold text-blue-700
                                        hover:bg-blue-100">
                                        Mượn sách
                                    </a>
                                }
                                else
                                {
                                    <button disabled
                                            class="flex-1 rounded-lg bg-slate-100 px-1 py-2
                                        text-xs text-slate-400">
                                        Hết sách
                                    </button>
                                }

                                <button type="button"
                                        title="Yêu thích"
                                        class="rounded-lg bg-slate-50 px-2 py-2
                                    text-sm text-slate-600 hover:bg-pink-50
                                    hover:text-pink-600">
                                    ♡
                                </button>

                            </div>

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>