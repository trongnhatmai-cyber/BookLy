
@model IEnumerable<BookLy_Project.Models.Book>

@{
    ViewData["Title"] = "Sách yêu thích";
}

<div class="min-h-screen bg-slate-50 px-6 py-8">

    <div class="mx-auto max-w-7xl">

        <h1 class="mb-2 text-3xl font-bold text-slate-800">
            ❤️ Sách yêu thích
        </h1>

        <p class="mb-8 text-slate-500">
            Những cuốn sách bạn đã lưu vào danh sách yêu thích.
        </p>

        @if (!Model.Any())
        {
            <div class="rounded-2xl bg-white p-10 text-center shadow-sm">
                <div class="mb-4 text-5xl">📚</div>

                <h2 class="mb-2 text-xl font-semibold text-slate-700">
                    Chưa có sách yêu thích
                </h2>

                <p class="mb-6 text-slate-500">
                    Hãy khám phá và thêm những cuốn sách bạn yêu thích nhé!
                </p>

                <a asp-controller="Book"
                   asp-action="Index"
                   class="rounded-lg bg-blue-600 px-5 py-3 text-white hover:bg-blue-700">
                    Khám phá sách
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">

                @foreach (var book in Model)
                {
                    <div class="flex w-80 shrink-0 flex-col rounded-2xl
                        border border-slate-100 bg-white p-4
                        shadow-sm transition hover:-translate-y-1 hover:shadow-md">

                        <!-- ẢNH SÁCH -->
                        <a asp-controller="Home"
                               asp-action="Details"
                               asp-route-id="@book.BookId">
                            @if (book.ImageUrl is null)
                            {
                                <div class="flex h-60 items-center justify-center
                                    rounded-xl bg-gradient-to-br from-blue-400 to-blue-800
                                    p-2 text-center text-xl font-semibold text-white">
                                    @book.Title
                                </div>
                            }
                            else
                            {
                                <img src="@book.ImageUrl"
                                     alt="@book.Title"
                                     class="h-60 w-full rounded-xl object-cover" />
                            }


                            <h3 class="mt-3 truncate text-lg font-bold text-slate-900">
                                @book.Title
                            </h3>

                        </a>

                        <!-- TÁC GIẢ -->
                        <p class="mt-1 truncate text-xs text-slate-400">
                            @(book.Author ?? "Chưa cập nhật")
                        </p>

                        <!-- THỂ LOẠI -->
                        <div class="mt-2">
                            <span class="inline-block max-w-full truncate rounded-lg
                                bg-blue-50 px-2 py-1 text-xs text-blue-600">
                                @(book.Category?.CategoryName ?? "Chưa phân loại")
                            </span>
                        </div>

                        <!-- TÌNH TRẠNG -->
                        <div class="mt-2">
                            @if (book.AvailableQuantity > 0)
                            {
                                <span class="text-xs font-medium text-green-600">
                                    Còn sách
                                </span>
                            }
                            else
                            {
                                <span class="text-xs font-medium text-red-500">
                                    Hết sách
                                </span>
                            }
                        </div>

                        <!-- NÚT -->
                        <div class="mt-3 flex gap-1.5">

                            @if (book.AvailableQuantity > 0)
                            {
                                <a asp-controller="Home"
                                       asp-action="Details"
                                       asp-route-id="@book.BookId"
                                       class="flex-1 rounded-lg bg-blue-50 px-1 py-2
                                    text-center text-xs font-semibold text-blue-700
                                    hover:bg-blue-100">
                                    Mượn sách
                                </a>
                            }
                            else
                            {
                                <button disabled
                                        class="flex-1 rounded-lg bg-slate-100 px-1 py-2
                                    text-xs text-slate-400">
                                    Hết sách
                                </button>
                            }

                            <form asp-controller="Home"
                                  asp-action="ToggleFavorite"
                                  asp-route-id="@book.BookId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="rounded-lg bg-pink-100 px-3 py-2 text-sm text-pink-600 hover:bg-pink-200">
                                    💔 Bỏ thích
                                </button>

                            </form>

                        </div>

                    </div>

                }

            </div>
        }

    </div>

</div>
