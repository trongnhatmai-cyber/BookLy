@model IEnumerable<BookLy_Project.Models.Book>;
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="w-full min-w-0">
    
    <!-- HEADER / WELCOME SECTION -->
    <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-1">
            Chào bạn, người yêu sách
        </h1>
        <p class="text-slate-500 text-sm md:text-base">Hôm nay bạn muốn đọc gì?</p>
    </div>

    <!-- TÌM KIẾM VÀ LỌC SÁCH -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-3 mb-5 items-center">
        <input id="homeBookSearch" type="search" placeholder="Tìm tên sách hoặc tác giả..."
               class="w-full md:flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500" />
        <select id="homeCategoryFilter" class="w-full md:w-48 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm">
            <option value="">Tất cả thể loại</option>
            @foreach (var category in Model.Where(b => b.Category != null).Select(b => b.Category!.CategoryName).Distinct().OrderBy(x => x))
            {
                <option value="@category">@category</option>
            }
        </select>
        <select id="homeAvailabilityFilter" class="w-full md:w-48 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm">
            <option value="">Mọi tình trạng</option>
            <option value="available">Còn sách</option>
            <option value="unavailable">Hết sách</option>
        </select>
        <button id="homeResetFilters" type="button" class="w-full md:w-auto px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-medium">Xóa lọc</button>
    </div>
    <p id="homeBookCount" class="mb-5 text-sm text-slate-500" aria-live="polite"></p>

    <!-- SECTION: SÁCH NỔI BẬT -->
    <div class="mb-10">

        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900">
                Sách nổi bật
            </h2>

            <div class="flex gap-2">
                <button type="button"
                        onclick="document.getElementById('bookSlider').scrollBy({left: -400, behavior: 'smooth'})"
                        class="rounded-full border border-slate-200 bg-white p-2
                    text-slate-600 shadow-sm hover:bg-slate-100">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M19 12H5m0 0 7-7m-7 7 7 7"/></svg>
                </button>

                <button type="button"
                        onclick="document.getElementById('bookSlider').scrollBy({left: 400, behavior: 'smooth'})"
                        class="rounded-full border border-slate-200 bg-white p-2
                    text-slate-600 shadow-sm hover:bg-slate-100">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14m0 0-7-7m7 7-7 7"/></svg>
                </button>
            </div>
        </div>

        <!-- HÀNG SÁCH TRƯỢT NGANG -->
        <div id="bookSlider"
             class="flex gap-4 overflow-x-auto scroll-smooth pb-4"
             style="scrollbar-width: none;">

            @foreach (var book in Model)
            {
                <div class="book-filter-card flex w-80 shrink-0 flex-col rounded-2xl
                    border border-slate-100 bg-white p-4
                    shadow-sm transition hover:-translate-y-1 hover:shadow-md"
                    data-title="@(book.Title ?? "")" data-author="@(book.Author ?? "")"
                    data-category="@(book.Category?.CategoryName ?? "")"
                    data-availability="@((book.AvailableQuantity ?? 0) > 0 ? "available" : "unavailable")">

                    <!-- ẢNH SÁCH -->
                    <a asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@book.BookId">
                        @if (book.ImageUrl is null)
                            {
                            <div class="flex h-60 items-center justify-center
                                rounded-xl bg-gradient-to-br from-blue-400 to-blue-800  
                                p-2 text-center text-xl font-semibold text-white">
                                @book.Title
                            </div>
                            }
                            else
                            {
                                <img src="@book.ImageUrl"
                                alt="@book.Title"
                                class="h-60 w-full rounded-xl object-cover" />
                            }


                        <h3 class="mt-3 truncate text-lg font-bold text-slate-900">
                            @book.Title
                        </h3>

                    </a>

                    <!-- TÁC GIẢ -->
                    <p class="mt-1 truncate text-xs text-slate-400">
                        @(book.Author ?? "Chưa cập nhật")
                    </p>

                    <!-- THỂ LOẠI -->
                    <div class="mt-2">
                        <span class="inline-block max-w-full truncate rounded-lg
                            bg-blue-50 px-2 py-1 text-xs text-blue-600">
                            @(book.Category?.CategoryName ?? "Chưa phân loại")
                        </span>
                    </div>

                    <!-- TÌNH TRẠNG -->
                    <div class="mt-2">
                        @if (book.AvailableQuantity > 0)
                        {
                            <span class="text-xs font-medium text-green-600">
                                Còn sách
                            </span>
                        }
                        else
                        {
                            <span class="text-xs font-medium text-red-500">
                                Hết sách
                            </span>
                        }
                    </div>

                    <!-- NÚT -->
                    <div class="mt-3 flex gap-1.5">

                        @if (book.AvailableQuantity > 0)
                        {
                                <form asp-controller="Home" asp-action="Borrow" method="post" asp-route-id="@book.BookId" >
                                    @Html.AntiForgeryToken()

                                <button type="submit" class="flex-1 rounded-lg bg-blue-50 px-1 py-2  text-center text-xs font-semibold text-blue-700
                                    hover:bg-blue-100">
                                        Mượn sách
                                    </button>
                                </form>
                        }
                        else
                        {
                            <button disabled
                                    class="flex-1 rounded-lg bg-slate-100 px-1 py-2
                                text-xs text-slate-400">
                                Hết sách
                            </button>
                        }

                    </div>

                </div>
            }

        </div>
        <div id="homeNoBooks" class="hidden rounded-xl bg-white p-8 text-center text-slate-500">Không tìm thấy sách phù hợp với bộ lọc.</div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const search = document.getElementById('homeBookSearch');
            const category = document.getElementById('homeCategoryFilter');
            const availability = document.getElementById('homeAvailabilityFilter');
            const cards = Array.from(document.querySelectorAll('#bookSlider .book-filter-card'));
            const empty = document.getElementById('homeNoBooks');
            const count = document.getElementById('homeBookCount');
            const normalize = value => (value || '').toLocaleLowerCase('vi').normalize('NFC').trim();
            function applyFilters() {
                const keyword = normalize(search.value);
                let visible = 0;
                cards.forEach(card => {
                    const textMatch = normalize(card.dataset.title).includes(keyword) || normalize(card.dataset.author).includes(keyword);
                    const categoryMatch = !category.value || card.dataset.category === category.value;
                    const statusMatch = !availability.value || card.dataset.availability === availability.value;
                    const show = textMatch && categoryMatch && statusMatch;
                    card.classList.toggle('hidden', !show);
                    if (show) visible++;
                });
                empty.classList.toggle('hidden', visible !== 0);
                count.textContent = `Hiển thị ${visible}/${cards.length} cuốn sách`;
            }
            [search, category, availability].forEach(el => el.addEventListener(el === search ? 'input' : 'change', applyFilters));
            document.getElementById('homeResetFilters').addEventListener('click', () => { search.value=''; category.value=''; availability.value=''; applyFilters(); });
            applyFilters();
        });
    </script>
}