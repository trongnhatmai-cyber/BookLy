@model IEnumerable<BookLy_Project.Models.Book>;
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="w-full pr-6">
    
    <!-- HEADER / WELCOME SECTION -->
    <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-1">
            Chào bạn, người yêu sách 👋
        </h1>
        <p class="text-slate-500 text-sm md:text-base">Hôm nay bạn muốn đọc gì?</p>
    </div>

    <!-- SEARCH & FILTER BAR -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-3 mb-10 items-center">
        
        <!-- Input tìm kiếm -->
        <div class="relative flex-1 w-full">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </span>
            <input type="text" placeholder="Tìm tên sách, tác giả..."
                   class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition">
        </div>

        <!-- Dropdown Thể loại -->
        <div class="relative w-full md:w-48">
            <button type="button" id="genreDropdownBtn"
                    class="w-full flex items-center justify-between px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none hover:bg-slate-100 transition">
                <span>Thể loại</span>
                <svg class="w-4 h-4 text-slate-400 transition-transform duration-200" id="genreArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="genreMenu" class="hidden absolute left-0 right-0 mt-2 bg-white border border-slate-100 rounded-xl shadow-lg z-20 py-2 max-h-60 overflow-y-auto">
                <!-- COMMENT: @@foreach(var category in Model.Categories) { -->
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Tất cả thể loại</a>
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Tiểu thuyết</a>
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Kỹ năng</a>
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Tư duy</a>
                <!-- COMMENT: } -->
            </div>
        </div>

        <!-- Dropdown Mượn trả -->
        <div class="relative w-full md:w-48">
            <button type="button" id="statusDropdownBtn"
                    class="w-full flex items-center justify-between px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none hover:bg-slate-100 transition">
                <span>Mượn trả</span>
                <svg class="w-4 h-4 text-slate-400 transition-transform duration-200" id="statusArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="statusMenu" class="hidden absolute left-0 right-0 mt-2 bg-white border border-slate-100 rounded-xl shadow-lg z-20 py-2">
                <!-- COMMENT: Tình trạng từ Database -->
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Tất cả trạng thái</a>
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Có sẵn</a>
                <a href="#" class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600">Đang mượn</a>
            </div>
        </div>

        <!-- Nút Tìm -->
        <button type="button" class="w-full md:w-auto px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl text-sm transition shadow-sm shadow-blue-200">
            Tìm sách
        </button>
    </div>


    <!-- SECTION: SÁCH NỔI BẬT -->
    <div class="mb-10">

        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900">
                Sách nổi bật
            </h2>

            <div class="flex gap-2">
                <button type="button"
                        onclick="document.getElementById('bookSlider').scrollBy({left: -400, behavior: 'smooth'})"
                        class="rounded-full border border-slate-200 bg-white p-2
                    text-slate-600 shadow-sm hover:bg-slate-100">
                    &#8592;
                </button>

                <button type="button"
                        onclick="document.getElementById('bookSlider').scrollBy({left: 400, behavior: 'smooth'})"
                        class="rounded-full border border-slate-200 bg-white p-2
                    text-slate-600 shadow-sm hover:bg-slate-100">
                    &#8594;
                </button>
            </div>
        </div>

        <!-- HÀNG SÁCH TRƯỢT NGANG -->
        <div id="bookSlider"
             class="flex gap-4 overflow-x-auto scroll-smooth pb-4"
             style="scrollbar-width: none;">

            @foreach (var book in Model)
            {
                <div class="flex w-80 shrink-0 flex-col rounded-2xl
                    border border-slate-100 bg-white p-4
                    shadow-sm transition hover:-translate-y-1 hover:shadow-md">

                    <!-- ẢNH SÁCH -->
                    <a asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@book.BookId">
                        @if (book.ImageUrl is null)
                            {
                            <div class="flex h-60 items-center justify-center
                                rounded-xl bg-gradient-to-br from-blue-400 to-blue-800  
                                p-2 text-center text-xl font-semibold text-white">
                                @book.Title
                            </div>
                            }
                            else
                            {
                                <img src="@book.ImageUrl"
                                alt="@book.Title"
                                class="h-60 w-full rounded-xl object-cover" />
                            }


                        <h3 class="mt-3 truncate text-lg font-bold text-slate-900">
                            @book.Title
                        </h3>

                    </a>

                    <!-- TÁC GIẢ -->
                    <p class="mt-1 truncate text-xs text-slate-400">
                        @(book.Author ?? "Chưa cập nhật")
                    </p>

                    <!-- THỂ LOẠI -->
                    <div class="mt-2">
                        <span class="inline-block max-w-full truncate rounded-lg
                            bg-blue-50 px-2 py-1 text-xs text-blue-600">
                            @(book.Category?.CategoryName ?? "Chưa phân loại")
                        </span>
                    </div>

                    <!-- TÌNH TRẠNG -->
                    <div class="mt-2">
                        @if (book.AvailableQuantity > 0)
                        {
                            <span class="text-xs font-medium text-green-600">
                                Còn sách
                            </span>
                        }
                        else
                        {
                            <span class="text-xs font-medium text-red-500">
                                Hết sách
                            </span>
                        }
                    </div>

                    <!-- NÚT -->
                    <div class="mt-3 flex gap-1.5">

                        @if (book.AvailableQuantity > 0)
                        {
                                <form asp-controller="Home" asp-action="Borrow" method="post" asp-route-id="@book.BookId" >
                                    @Html.AntiForgeryToken()

                                <button type="submit" class="flex-1 rounded-lg bg-blue-50 px-1 py-2  text-center text-xs font-semibold text-blue-700
                                    hover:bg-blue-100">
                                        Mượn sách
                                    </button>
                                </form>
                        }
                        else
                        {
                            <button disabled
                                    class="flex-1 rounded-lg bg-slate-100 px-1 py-2
                                text-xs text-slate-400">
                                Hết sách
                            </button>
                        }

                    </div>

                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function setupDropdown(btnId, menuId, arrowId) {
                const btn = document.getElementById(btnId);
                const menu = document.getElementById(menuId);
                const arrow = document.getElementById(arrowId);
                const span = btn.querySelector('span');

                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    // Đóng các menu khác nếu có
                    document.querySelectorAll('[id$="Menu"]').forEach(m => {
                        if (m !== menu) m.classList.add('hidden');
                    });
                    document.querySelectorAll('[id$="Arrow"]').forEach(a => {
                        if (a !== arrow) a.classList.remove('rotate-180');
                    });

                    menu.classList.toggle('hidden');
                    arrow.classList.toggle('rotate-180');
                });

                menu.querySelectorAll('a').forEach(item => {
                    item.addEventListener('click', function (e) {
                        e.preventDefault();
                        span.textContent = this.textContent;
                        menu.classList.add('hidden');
                        arrow.classList.remove('rotate-180');
                    });
                });
            }

            setupDropdown('genreDropdownBtn', 'genreMenu', 'genreArrow');
            setupDropdown('statusDropdownBtn', 'statusMenu', 'statusArrow');

            // Click ra ngoài thì ẩn tất cả popup
            document.addEventListener('click', function () {
                document.querySelectorAll('[id$="Menu"]').forEach(m => m.classList.add('hidden'));
                document.querySelectorAll('[id$="Arrow"]').forEach(a => a.classList.remove('rotate-180'));
            });

            // Hiệu ứng nút Yêu thích
            const favoriteButtons = document.querySelectorAll('.favorite-btn');
            favoriteButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const svg = this.querySelector('svg');
                    if (this.classList.contains('bg-red-500')) {
                        this.classList.remove('bg-red-500', 'text-white', 'border-red-500');
                        this.classList.add('border-slate-200', 'text-slate-400', 'hover:bg-red-50', 'hover:text-red-500');
                        svg.setAttribute('fill', 'none');
                    } else {
                        this.classList.remove('border-slate-200', 'text-slate-400', 'hover:bg-red-50', 'hover:text-red-500');
                        this.classList.add('bg-red-500', 'text-white', 'border-red-500');
                        svg.setAttribute('fill', 'currentColor');
                    }
                });
            });
        });
    </script>
}