<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Bookly</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Inter', sans-serif;
        background-color: #F8FAFC;
        }
    </style>
</head>
<body class="bg-slate-50">

    @if (TempData["Success"] != null)
    {
        <div id="notification"
             class="bg-green-100 text-green-700 p-4 rounded-lg m-4">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="notification"
             class="bg-red-100 text-red-700 p-4 rounded-lg m-4">
            @TempData["Error"]
        </div>
    }

    <script>
        setTimeout(function () {
        var notification = document.getElementById("notification");

        if (notification) {
        notification.style.transition = "opacity 0.5s";
        notification.style.opacity = "0";

        setTimeout(function () {
        notification.remove();
        }, 500);
        }
        }, 5000);
    </script>

    <!-- Flex Container bao bọc Layout và Nội dung -->
    <div class="min-h-screen flex flex-col md:flex-row">
        
        <!-- SIDEBAR MENU BÊN TRÁI -->
        <aside class="w-full md:w-64 bg-white border-r border-slate-100 p-6 flex flex-col justify-between shrink-0">
            <div>
                <!-- Logo -->
                <div class="flex items-center gap-2 mb-8">
                    <span class="text-xl font-bold text-blue-600">Bookly</span>
                    <span class="text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md">thư viện</span>
                </div>
                
                <!-- Menu Links -->
                <nav class="space-y-5">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-3 bg-blue-50 text-blue-600 font-medium rounded-xl text-sm transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                        Trang chủ
                    </a>
                    @if (Context.Session.GetString("Name") != null)
                        {
                            <a asp-action="Favorities" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 font-medium rounded-xl text-sm transition">
                                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                Yêu thích
                            </a>
                            <a asp-action="BorrowHistory" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 font-medium rounded-xl text-sm transition">
                                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Lịch sử mượn
                            </a>
                            <a asp-controller="Home"
                                   asp-action="Profile"
                                   class="flex items-center gap-3 rounded-xl px-4 py-3
                                text-slate-600 hover:bg-blue-50 hover:text-blue-600">
                                <span>👤</span>
                                <span>Hồ sơ người dùng</span>
                            </a>
                            <a asp-controller="Home"
                               asp-action="Logout"
                               class="flex items-center gap-3 rounded-xl px-4 py-3
                                      text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                                <span>↪</span>
                                <span>Đăng xuất</span>
                            </a>
                        }
                        @if(Context.Session.GetString("Name") == null)
                        {
                            <a id="login-button" class="flex items-center gap-3 px-4 py-3 text-white bg-blue-600 font-medium rounded-xl text-sm transition">
                                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                Login
                            </a>
                        }
                    </nav>
            </div>

            <!-- Profile Footer -->
            <div class="mt-8 pt-4 border-t border-slate-100">
                <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-2xl">
                    <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold text-sm">B</div>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900">Bạn đọc Bookly</h4>
                        <p class="text-xs text-slate-400">Thành viên</p>
                    </div>
                </div>
            </div>
        </aside>


        <main class="flex-1 p-6 md:p-10 overflow-y-auto">

            @RenderBody()

            <!-- LOGIN MODAL -->
            <div id="login-panel"
                 class="fixed inset-0 z-50 hidden
                flex items-center justify-center">

                <!-- Nền tối phía sau -->
                <div id="login-overlay"
                     class="absolute inset-0
                    bg-slate-900/30
                    backdrop-blur-sm">
                </div>

                <!-- FORM NHỎ -->
                <div class="relative z-10
                    w-[90%] max-w-md
                    bg-white
                    rounded-3xl
                    shadow-2xl
                    p-8 md:p-10">

                    <!-- Nút đóng -->
                    <button id="close-login"
                            type="button"
                            class="absolute top-5 right-5
                        w-9 h-9
                        flex items-center justify-center
                        rounded-full
                        bg-slate-100
                        hover:bg-slate-200
                        text-slate-500
                        text-xl
                        transition">
                        ×
                    </button>


                    <!-- Tiêu đề -->
                    <div class="mb-7">

                        <span class="inline-flex
                            px-4 py-2
                            bg-blue-50
                            text-blue-600
                            rounded-full
                            text-xs
                            font-semibold">
                            CHÀO MỪNG TRỞ LẠI
                        </span>

                        <h1 class="mt-5
                            text-3xl
                            font-bold
                            text-slate-900">
                            Đăng nhập
                        </h1>

                        <p class="mt-2
                            text-sm
                            text-slate-500
                            leading-relaxed">
                            Đăng nhập để tiếp tục khám phá thư viện BOOKLY.
                        </p>

                    </div>


                    <!-- FORM -->
                    <form asp-controller="Home"
                          asp-action="Login"
                          method="post"
                          class="space-y-5">

                        <!-- Username -->
                        <div>

                            <label for="Username"
                                   class="block mb-2
                                text-sm
                                font-semibold
                                text-slate-700">
                                Tên đăng nhập
                            </label>

                            <input type="text"
                                   id="Name"
                                   name="Username"
                                   placeholder="Nhập tên đăng nhập"
                                   class="w-full
                            px-4 py-3
                            border
                            border-slate-200
                            rounded-xl
                            outline-none
                            focus:border-blue-500
                            focus:ring-4
                            focus:ring-blue-100
                            transition"
                                   required>

                        </div>


                        <!-- Password -->
                        <div>

                            <div class="flex justify-between mb-2">

                                <label for="Passwordd"
                                       class="text-sm
                                    font-semibold
                                    text-slate-700">
                                    Mật khẩu
                                </label>

                                <p class="text-xs
                                    text-blue-600
                                    hover:text-blue-700">
                                    Quên mật khẩu thì xin vui lòng liên hệ với Thủ Thư.
                                </p>

                            </div>

                            <input type="password"
                                   id="password"
                                   name="Passwordd"
                                   placeholder="Nhập mật khẩu"
                                   class="w-full
                            px-4 py-3
                            border
                            border-slate-200
                            rounded-xl
                            outline-none
                            focus:border-blue-500
                            focus:ring-4
                            focus:ring-blue-100
                            transition"
                                   required>

                        </div>


                        <!-- Remember -->
                        <div class="flex items-center gap-2">

                            <input type="checkbox"
                                   id="remember"
                                   name="RememberMe"
                                   class="w-4 h-4 accent-blue-600">

                            <label for="remember"
                                   class="text-sm text-slate-500">
                                Ghi nhớ đăng nhập
                            </label>

                        </div>
                        @if (TempData["LoginFail"] != null)
                        {
                            <p class="text-sm text-red-500">
                                @TempData["LoginFail"]
                            </p>
                        }


                        <!-- Login -->
                        <button type="submit"
                                class="w-full
                            py-3
                            bg-blue-600
                            hover:bg-blue-700
                            text-white
                            font-semibold
                            rounded-xl
                            shadow-lg
                            shadow-blue-200
                            transition">
                            Đăng nhập →
                        </button>

                    </form>

                </div>

            </div>

        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
<script>
    const loginButton = document.getElementById("login-button");
    const loginPanel = document.getElementById("login-panel");
    const closeLogin = document.getElementById("close-login");
    const loginOverlay = document.getElementById("login-overlay");
    const openLogin = '@TempData["OpenLogin"]';

    // Mở form đăng nhập
    if (loginButton) {
    loginButton.addEventListener("click", function (e) {
    e.preventDefault();

    loginPanel.classList.remove("hidden");
    document.body.classList.add("overflow-hidden");
    });
    }

    if (openLogin === "true") {
    const loginPanel = document.getElementById("login-panel");

    if (loginPanel) {
    loginPanel.classList.remove("hidden");
    document.body.classList.add("overflow-hidden");
    }
    }

    // Đóng form
    if (closeLogin) {
    closeLogin.addEventListener("click", function () {
    loginPanel.classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
    });
    }

    // Nhấn ESC để đóng
    document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
    loginPanel.classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
    }
    });
</script>
</html>